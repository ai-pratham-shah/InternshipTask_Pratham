<odoo>
    <!-- list View for Books -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="publication_date"/>
                <field name="state"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Form View for Books -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group name="col2">
                        <group>
                            <field name="name"/>
                            <field name="author"/>
                            <field name="isbn"/>
                        </group>
                        <group>
                            <field name="publication_date"/>
                            <field name="state"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Books List View -->
    <record id="action_library_books" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_library_book_list"/>
    </record>


    <!-- Library Book Menu -->
    <menuitem id="menu_library_management" name="Library" sequence="1"/>
    <!-- Submenu for Books -->
    <menuitem id="menu_library_books" name="Library management" parent="menu_library_management" action="action_library_books" sequence="1"/>




    <!-- Submenu for Members -->
<!--    <menuitem id="menu_library_books" name="Members" parent="menu_library_management" action="action_library_books" sequence="2"/>-->
</odoo>



